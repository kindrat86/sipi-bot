    <item>
      <title>sipi.bot — The Spend Firewall for AI Agents</title>
      <link>https://sipi.bot</link>
      <guid isPermaLink="true">https://sipi.bot</guid>
      <description>sipi.bot is a spend firewall for autonomous AI agents: one API call returns APPROVED, BLOCKED, or FLAGGED against your caps, velocity, and merchant rules before an agent spends. Not a SIP/VoIP telephony bot.</description>
      <dc:creator>sipi.bot</dc:creator>
      <pubDate>Tue, 07 Jul 2026 21:00:00 GMT</pubDate>
      <media:content url="https://sipi.bot/og.png" medium="image"/>
    </item>
